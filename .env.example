# An operator-only form for introductions between consenting participants.
# No account secrets are shipped here. Use local environment values when running the app.
# Email setup: docs/email-setup.md. For a local preview without credentials, use MAIL_MODE=log with npm run dev.

APP_URL=http://localhost:3000 # Origin of the introduction form; owner submissions must match this address.
HOST=127.0.0.1 # Where the server listens; this loopback value does not expose it to other machines.
PORT=3000 # Port used by both npm run dev and npm start.
DB_PATH=.data/app.sqlite # Introduction details, consent records, and each participant email; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # Use a unique random password, at least 16 characters, for admin to prepare introductions and inspect send results.
MAIL_MODE=sandbox # Select sandbox, production, or development-only log for participant introductions.
MAIL_FROM=sender@example.com # From address on participant introductions; use your verified Mailtrap sending domain in production.
MAILTRAP_PRODUCTION_TOKEN= # Production credential for participant introductions; obtain a transactional sending token from your Mailtrap account.
MAILTRAP_SANDBOX_TOKEN= # API token with access to the Sandbox used for referral introduction messages.
MAILTRAP_INBOX_ID= # Numeric Sandbox ID from its API integration settings; captured introduction email stays here.
